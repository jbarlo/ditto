# Turso purposefully omitted for local dev

# Image Storage (R2)
# Leave empty for local filesystem storage (dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# WorkOS Auth
# Required
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Claim Code HMAC Secret
# Used to generate time-limited claim codes for device pairing
# Generate with: openssl rand -base64 32
# Required
CLAIM_SECRET=your-secret-key

# Base URL for generating device-facing URLs
# Required
BASE_URL=http://localhost:3000
